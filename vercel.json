{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node migrate.mjs",
  "outputDirectory": "public",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/agent.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/tick.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/setup.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/social.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/asset.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/observe.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/audience.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/inbox.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/media.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/manual-replies.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/room.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/works.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/project.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/atelier.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/atelier-worker.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg}"
    },
    "api/gauntlet.mjs": {
      "maxDuration": 120,
      "includeFiles": "{private/**,public/series/afterimage-*.jpg,schema.sql}"
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/setup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/social",
      "schedule": "1-56/5 * * * *"
    },
    {
      "path": "/api/observe",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/audience",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/media",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/project",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/atelier-worker",
      "schedule": "7,27,47 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/nothing-important",
      "destination": "/nothing-important.html"
    },
    {
      "source": "/unplanned",
      "destination": "/unplanned.html"
    },
    {
      "source": "/soft-days",
      "destination": "/small-interruptions.html"
    },
    {
      "source": "/collections",
      "destination": "/collections.html"
    },
    {
      "source": "/small-interruptions",
      "destination": "/small-interruptions.html"
    },
    {
      "source": "/out-of-frame",
      "destination": "/out-of-frame.html"
    },
    {
      "source": "/character",
      "destination": "/character.html"
    },
    {
      "source": "/work/:id",
      "destination": "/work-detail.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/work",
      "destination": "/work.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/journal",
      "destination": "/journal.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/behind",
      "destination": "/behind.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
