{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node migrate.mjs",
  "outputDirectory": "public",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/agent.mjs": {
      "maxDuration": 120
    },
    "api/tick.mjs": {
      "maxDuration": 120
    },
    "api/setup.mjs": {
      "maxDuration": 120
    },
    "api/social.mjs": {
      "maxDuration": 120,
      "includeFiles": "reference-board-*.png"
    },
    "api/asset.mjs": {
      "maxDuration": 120
    },
    "api/observe.mjs": {
      "maxDuration": 120
    },
    "api/audience.mjs": {
      "maxDuration": 120
    },
    "api/inbox.mjs": {
      "maxDuration": 120
    },
    "api/media.mjs": {
      "maxDuration": 120,
      "includeFiles": "reference-board-*.png"
    },
    "api/manual-replies.mjs": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/setup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/social",
      "schedule": "1-56/5 * * * *"
    },
    {
      "path": "/api/observe",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/audience",
      "schedule": "2-57/5 * * * *"
    },
    {
      "path": "/api/media",
      "schedule": "*/2 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}